{
  "name": "bdl-desktop",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint \"src/**/*.{ts,vue}\" vite.config.ts vitest.config.ts --max-warnings 0 --cache",
    "lint:styles": "stylelint \"src/**/*.{css,vue}\" && pnpm lint:tailwind",
    "lint:tailwind": "node scripts/check-tailwind-syntax.mjs",
    "format:styles": "prettier --write \"src/**/*.css\"",
    "format:styles:check": "prettier --check \"src/**/*.css\"",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:windows-smoke": "node scripts/windows-webview-smoke.mjs",
    "android:release": "node ../../scripts/package-android-release.mjs",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@iconify-json/tabler": "^1.2.35",
    "@iconify/vue": "^5.0.1",
    "@nuxt/ui": "^4.9.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^16.5.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
