{
  "name": "bdl-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "lint:styles": "stylelint \"src/**/*.{css,vue}\"",
    "format:styles": "prettier --write \"src/**/*.css\"",
    "format:styles:check": "prettier --check \"src/**/*.css\"",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@iconify-json/tabler": "^1.2.35",
    "@nuxt/ui": "^4.9.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript": "5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
