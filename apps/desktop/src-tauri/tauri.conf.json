{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BDL",
  "version": "0.1.0",
  "identifier": "com.yueli.bdl",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BDL",
        "width": 1080,
        "height": 720,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDQ0RGOUEyNDQ3MzM4NDYKUldSR09ITkVvdm5OdkVVb1hYK08yaWE0V0dvUTY5Q1V0bUs4RE5VL05jcDhjZUl3YzlydWJGV00K",
      "endpoints": [
        "https://github.com/Yuelioi/bdl/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
